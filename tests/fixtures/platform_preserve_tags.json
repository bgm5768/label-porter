{
  "schema_version": 1,
  "name": "013 · 어절·시간·전사 반영 / 발음 오류 태그 원본 유지",
  "description": "라벨 포터 2.4 이상. 플랫폼 어절을 시작 시간순으로 정렬하여 목록을 전체 재구성합니다. 추가/삭제/분할/병합과 텍스트 수정을 반영하고 어절 ID는 1부터 다시 부여합니다. 시간은 소수점 한 자리 반올림, 전사는 최종 어절을 공백으로 연결합니다. PronunciationErrorTags는 세그멘테이션과 별도 데이터이므로 원본 값·ID·순서를 그대로 보존하며 재연결, 제거, 참조 검사, 별도 검토를 하지 않습니다. 결과에 없는 원본 레코드는 보존합니다.",
  "source": {
    "glob": "**/*.json",
    "record_mode": "object",
    "key": {
      "meta": "file_name"
    }
  },
  "result": {
    "format": "json",
    "record_mode": "auto",
    "key": {
      "path": "/importData_ID_M4AAXZ",
      "transforms": [
        {
          "op": "basename"
        }
      ]
    }
  },
  "rules": [
    {
      "kind": "rebuild_items",
      "from": "/orthographic_1/data",
      "to": "/Segmentation/eojeols",
      "sort_by": "/value/startTime",
      "source_key": {
        "scope": "source",
        "path": "/eojeolID"
      },
      "result_key": {
        "path": "/objectID",
        "transforms": [
          {
            "op": "regex",
            "pattern": "_([0-9]+)$",
            "group": 1
          },
          {
            "op": "integer"
          }
        ]
      },
      "rules": [
        {
          "kind": "field",
          "from": {
            "meta": "item_number"
          },
          "to": "/eojeolID",
          "type": "integer",
          "allow_create": true
        },
        {
          "kind": "field",
          "from": {
            "path": "/value/name_J2REGU",
            "transforms": [
              {
                "op": "strip"
              }
            ]
          },
          "to": "/text",
          "type": "string",
          "allow_create": true
        },
        {
          "kind": "field",
          "from": {
            "path": "/value/startTime",
            "transforms": [
              {
                "op": "round",
                "digits": 1
              }
            ]
          },
          "to": "/start",
          "type": "number",
          "allow_create": true
        },
        {
          "kind": "field",
          "from": {
            "path": "/value/endTime",
            "transforms": [
              {
                "op": "round",
                "digits": 1
              }
            ]
          },
          "to": "/end",
          "type": "number",
          "allow_create": true
        }
      ]
    },
    {
      "kind": "field",
      "from": {
        "scope": "source",
        "path": "/Segmentation/eojeols",
        "transforms": [
          {
            "op": "pluck",
            "path": "/text"
          },
          {
            "op": "join",
            "separator": " "
          }
        ]
      },
      "to": "/RecordingMetadata/orthographic",
      "type": "string"
    }
  ],
  "assertions": [
    {
      "kind": "intervals",
      "path": "/Segmentation/eojeols",
      "start": "/start",
      "end": "/end",
      "ordered": true
    }
  ]
}
